{
  "name": "Theatre Reminder - Sabirni centar Watch",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 19 * * *"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Daily 19:00 Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "targetMonths",
              "value": "[\"2026-07\",\"2026-08\"]",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "playTitle",
              "value": "Sabirni centar",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "playUrl",
              "value": "https://www.suteatar.org/lat/predstave/sabirni-centar",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -160,
        0
      ],
      "notes": "Single place to edit which months to watch. Update targetMonths (JSON array of \"YYYY-MM\" strings) once Jul/Aug fill up or when a new season needs checking."
    },
    {
      "parameters": {
        "url": "https://www.suteatar.org/lat/repertoar",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          }
        }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Fetch Repertoire Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parses the raw repertoire HTML for performance entries in the target months\n// and checks whether the target play appears among them.\n// Verified against a real snapshot of https://www.suteatar.org/lat/repertoar.\n\nconst html = $input.first().json.html;\nconst config = $('Config').first().json;\nconst targetMonths = JSON.parse(config.targetMonths);\nconst playTitle = config.playTitle;\n\nconst items = [];\nconst liRegex = /<li class=\"work-item ([^\"]*)\">([\\s\\S]*?)<\\/li>\\s*(?=<li class=\"work-item|<\\/ul>)/g;\nlet m;\nwhile ((m = liRegex.exec(html)) !== null) {\n  const classAttr = m[1];\n  const block = m[2];\n  const monthMatch = classAttr.match(/(\\d{4}-\\d{2})/);\n  if (!monthMatch) continue;\n  const month = monthMatch[1];\n  const soldOut = /\\bticket-sold\\b/.test(classAttr);\n  const dayMatch = block.match(/<p>(\\d{1,2})<\\/p>/);\n  const timeMatch = block.match(/repertoire-time\">([^<]*)</);\n  const titleMatch = block.match(/data-title=\"([^\"]*)\"/);\n  items.push({\n    month,\n    soldOut,\n    day: dayMatch ? dayMatch[1] : null,\n    time: timeMatch ? timeMatch[1].trim() : null,\n    title: titleMatch ? titleMatch[1] : null,\n  });\n}\n\nconst itemsInRange = items.filter((i) => targetMonths.includes(i.month));\nconst foundItems = itemsInRange.filter((i) => i.title === playTitle);\n\nreturn [\n  {\n    json: {\n      itemsInRangeCount: itemsInRange.length,\n      foundCount: foundItems.length,\n      foundItems,\n      allSoldOut: foundItems.length > 0 && foundItems.every((i) => i.soldOut),\n      playUrl: config.playUrl,\n    },\n  },\n];\n"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Parse Repertoire",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-nonempty",
              "leftValue": "={{ $json.itemsInRangeCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Any listings in Jul-Aug?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-found",
              "leftValue": "={{ $json.foundCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Sabirni centar found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Nothing to report",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        800,
        150
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=🎭 *{{ $json.foundItems[0].title }}* is scheduled in Jul/Aug!\n\n{{ $json.foundItems.map(i => `• ${i.month}-${i.day} at ${i.time} — ${i.soldOut ? 'SOLD OUT' : 'available'}`).join('\\n') }}\n\n{{ $json.allSoldOut ? '⚠️ All listed dates are already sold out — keep watching, more dates may be added.' : '🎟️ Book now before it sells out!' }}\n\n{{ $json.playUrl }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Telegram - Found",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1040,
        -180
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=📋 Repertoire for Jul/Aug has been updated — still no *Sabirni centar* yet.\n\nWill keep checking daily at 19:00.\n\n{{ $json.playUrl }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "Telegram - Not Found Yet",
